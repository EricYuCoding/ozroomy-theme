{% doc %}
Renders product variant option values using the configured picker type.

@param {product} product - The product being selected.
@param {product_option} option - The current product option.
@param {block} block - The variant picker block settings.
@param {string} type - The configured picker type.
@param {boolean} [inventory_grouping_supported] - Whether a complete variant set is available for inventory grouping.

@example
{% render 'product-variant-options', product: product, option: option, block: block, type: 'swatches', inventory_grouping_supported: true %}
{% enddoc %}
{%- liquid
  assign variants_available_arr = product.variants | map: 'available'
  assign variants_option1_arr = product.variants | map: 'option1'
  assign variants_option2_arr = product.variants | map: 'option2'
  assign variants_option3_arr = product.variants | map: 'option3'

  assign product_form_id = 'product-form-' | append: section.id

  assign ready_to_ship_swatches = ''
  assign made_to_order_swatches = ''
  assign out_of_stock_swatches = ''
  assign untracked_swatches = ''
  assign missing_swatches = ''
  assign ungrouped_swatches = ''

  if type == 'quantity-breaks'
    assign badges = block.settings.breaks_badges | split: ','
    assign labels = block.settings.breaks_labels | split: ','
    assign benefits = block.settings.breaks_benefits | split: ','
    assign captions = block.settings.breaks_captions | split: ','
    assign price_texts = block.settings.breaks_price_texts | split: ','
    assign compare_price_texts = block.settings.breaks_compare_price_texts | split: ','
    if block.settings.breaks_displayed_images == 'custom'
      assign custom_images = block.settings.breaks_custom_images | split: ','
    endif
  endif
-%}

{%- for value in option.values -%}
  {%- liquid
    assign option_disabled = true
    assign option_index = forloop.index0
    assign option_value_name = value | append: ''

    for option1_name in variants_option1_arr
      case option.position
        when 1
          if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
          endif
        when 2
          if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
          endif
        when 3
          if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
          endif
      endcase
    endfor
     
    assign current_variant = nil

    if type == 'swatches' and inventory_grouping_supported
      assign candidate_option1 = product.selected_or_first_available_variant.option1
      assign candidate_option2 = product.selected_or_first_available_variant.option2
      assign candidate_option3 = product.selected_or_first_available_variant.option3

      case option.position
        when 1
          assign candidate_option1 = option_value_name
        when 2
          assign candidate_option2 = option_value_name
        when 3
          assign candidate_option3 = option_value_name
      endcase

      assign matching_variants = product.variants | where: 'option1', candidate_option1
      if candidate_option2 != blank
        assign matching_variants = matching_variants | where: 'option2', candidate_option2
      endif
      if candidate_option3 != blank
        assign matching_variants = matching_variants | where: 'option3', candidate_option3
      endif
      assign current_variant = matching_variants | first
    else
      for variant in product.variants
        case option.position
          when 1
            if variant.option1 == value
              assign current_variant = variant
              break
            endif
          when 2
            if variant.option1 == product.selected_or_first_available_variant.option1 and variant.option2 == value
              assign current_variant = variant
              break
            endif
          when 3
            if variant.option1 == product.selected_or_first_available_variant.option1 and variant.option2 == product.selected_or_first_available_variant.option2 and variant.option3 == value
              assign current_variant = variant
              break
            endif
        endcase
      endfor
    endif
  -%}

  {% case type %}
    {% when 'quantity-breaks' %}
      <input
        type="radio"
        id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
        name="{{ option.name }}"
        value="{{ value | escape }}"
        form="{{ product_form_id }}"
        {% if option.selected_value == value %}
          checked
        {% endif %}
        {% if option_disabled %}
          class="disabled"
        {% endif %}
      >
      {% liquid
        assign price = current_variant.price
        assign compare_price = current_variant.compare_at_price
        assign price_difference = compare_price | minus: price
        assign price_difference_rounded = price_difference | divided_by: 100.00 | round | times: 100
        
        assign badge = badges[forloop.index0] | replace: '[empty]', '' | strip
        assign label = labels[forloop.index0] | replace: '[empty]', '' | strip
        assign benefit = benefits[forloop.index0] | replace: '[empty]', '' | strip
        assign caption = captions[forloop.index0] | replace: '[empty]', '' | strip
        assign price_text = price_texts[forloop.index0] | replace: '[empty]', '' | strip
        assign compare_price_text = compare_price_texts[forloop.index0] | replace: '[empty]', '' | strip
      %}
      <label class="quantity-break" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
        {% if badge != blank %}
          <p class="quantity-break__badge dynamic-price">
            {% render 'text-with-price',
              text: badge,
              name: value,
              price: price,
              compare_price: compare_price,
              amount_saved: price_difference,
              amount_saved_rounded: price_difference_rounded
            %}
          </p>
        {% endif %}
        {% if block.settings.breaks_style == 'vertical' and block.settings.breaks_displayed_images != 'none' %}
          {% liquid
            if block.settings.breaks_displayed_images == 'variant_images'
              assign image_url = current_variant.featured_image | image_url
            else 
             assign image_url = custom_images[forloop.index0]
            endif
          %}
          {% if image_url != blank %}
            <div class='quantity-break__image'>
              <img 
                src='{{ image_url }}'
                alt="{{ value }}"
                width='auto'
                height='auto'
                loading='lazy'
              >
            </div>
          {% endif %}
        {% endif %}
        <div class="quantity-break__content">
          <div class="quantity-break__left">
            <span class="quantity-break__label">
              {% if label != blank %}
                <span class="quantity-break__label-text dynamic-price">
                  {% render 'text-with-price',
                    text: label,
                    name: value,
                    price: price,
                    compare_price: compare_price,
                    amount_saved: price_difference,
                    amount_saved_rounded: price_difference_rounded
                  %}
                </span>
              {% endif %}
              {% if benefit != blank %}
                <span class="quantity-break__benefit dynamic-price">
                  {% render 'text-with-price',
                    text: benefit,
                    name: value,
                    price: price,
                    compare_price: compare_price,
                    amount_saved: price_difference,
                    amount_saved_rounded: price_difference_rounded
                  %}
                </span>
              {% endif %}
            </span>
            {% if caption != blank %}
              <span class="quantity-break__caption dynamic-price">
                {% render 'text-with-price',
                  text: caption,
                  name: value,
                  price: price,
                  compare_price: compare_price,
                  amount_saved: price_difference,
                  amount_saved_rounded: price_difference_rounded
                %}
              </span>
            {% endif %}
          </div>
          <div class="quantity-break__right dynamic-price">
            {% if price_text != blank %}
              <span class="quantity-break__price">
                {% render 'text-with-price',
                  text: price_text,
                  name: value,
                  price: price,
                  compare_price: compare_price,
                  amount_saved: price_difference,
                  amount_saved_rounded: price_difference_rounded
                %}
              </span>
            {% endif %}
            {% if compare_price > price and compare_price_text != blank %}
              <span class="quantity-break__compare-price">
                {% render 'text-with-price',
                  text: compare_price_text,
                  name: value,
                  price: price,
                  compare_price: compare_price,
                  amount_saved: price_difference,
                  amount_saved_rounded: price_difference_rounded
                %}
              </span>
            {%- endif -%}
          </div>
        </div>
      </label>
    {%- when 'swatches' -%}
      {%- capture variant_option_key -%}option{{- option.position -}}{%- endcapture -%}
      {%- assign swatch_variants = product.variants | where: variant_option_key, option_value_name -%}
      {%- assign swatch_variant = swatch_variants | first -%}

      {%- if inventory_grouping_supported -%}
        {%- capture inventory_state -%}
          {%- render 'inventory-display-state', variant: current_variant -%}
        {%- endcapture -%}
        {%- assign inventory_state = inventory_state | strip -%}
      {%- else -%}
        {%- assign inventory_state = 'ungrouped' -%}
      {%- endif -%}

      {%- capture swatch_markup -%}
        {%- render 'inventory-variant-swatch',
          value: value,
          option: option,
          block: block,
          product_form_id: product_form_id,
          section_id: section.id,
          option_index: option_index,
          inventory_state: inventory_state,
          inventory_variant: current_variant,
          swatch_variant: swatch_variant,
          option_disabled: option_disabled
        -%}
      {%- endcapture -%}

      {%- if inventory_grouping_supported -%}
        {%- case inventory_state -%}
          {%- when 'in_stock', 'low_stock' -%}
            {%- assign ready_to_ship_swatches = ready_to_ship_swatches | append: swatch_markup -%}
          {%- when 'made_to_order' -%}
            {%- assign made_to_order_swatches = made_to_order_swatches | append: swatch_markup -%}
          {%- when 'out_of_stock' -%}
            {%- assign out_of_stock_swatches = out_of_stock_swatches | append: swatch_markup -%}
          {%- when 'untracked' -%}
            {%- assign untracked_swatches = untracked_swatches | append: swatch_markup -%}
          {%- else -%}
            {%- assign missing_swatches = missing_swatches | append: swatch_markup -%}
        {%- endcase -%}
      {%- else -%}
        {%- assign ungrouped_swatches = ungrouped_swatches | append: swatch_markup -%}
      {%- endif -%}
    {%- when 'pills' -%}
      <input
        type="radio"
        id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
        name="{{ option.name }}"
        value="{{ value | escape }}"
        form="{{ product_form_id }}"
        {% if option.selected_value == value %}
          checked
        {% endif %}
        {% if option_disabled %}
          class="disabled"
        {% endif %}
      >
      <label class="accent-color-{{ settings.variant_pills_accent_color }}{% if settings.variant_pills_bold_text %} variant-pills--bold{% endif %}" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
        {{ value -}}
        <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
      </label>
    {%- when 'dropdown' -%}
      <option
        value="{{ value | escape }}"
        {% if option.selected_value == value %}
          selected="selected"
        {% endif %}
      >
        {% if option_disabled -%}
          {{- 'products.product.value_unavailable' | t: option_value: value -}}
        {%- else -%}
          {{- value -}}
        {%- endif %}
      </option>
  {% endcase %}
{%- endfor -%}

{%- if type == 'swatches' -%}
  {%- if inventory_grouping_supported -%}
    <div
      class="inventory-swatch-group inventory-swatch-group--ready"
      data-inventory-swatch-group="ready_to_ship"
      role="group"
      aria-labelledby="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-ready"
      {% if ready_to_ship_swatches == blank %}
        hidden
      {% endif %}
    >
      <p class="inventory-swatch-group__title" id="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-ready">
        {{- 'inventory_v2.ready_to_ship' | t -}}
      </p>
      <div class="inventory-swatch-group__items" data-inventory-swatch-group-items>
        {{- ready_to_ship_swatches -}}
      </div>
    </div>
    <div
      class="inventory-swatch-group inventory-swatch-group--made-to-order"
      data-inventory-swatch-group="made_to_order"
      role="group"
      aria-labelledby="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-made-to-order"
      {% if made_to_order_swatches == blank %}
        hidden
      {% endif %}
    >
      <p class="inventory-swatch-group__title" id="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-made-to-order">
        {{- 'inventory_v2.made_to_order' | t -}}
      </p>
      <div class="inventory-swatch-group__items" data-inventory-swatch-group-items>
        {{- made_to_order_swatches -}}
      </div>
    </div>
    <div
      class="inventory-swatch-group inventory-swatch-group--out-of-stock"
      data-inventory-swatch-group="out_of_stock"
      role="group"
      aria-labelledby="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-out-of-stock"
      {% if out_of_stock_swatches == blank %}
        hidden
      {% endif %}
    >
      <p class="inventory-swatch-group__title" id="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-out-of-stock">
        {{- 'products.product.inventory_out_of_stock' | t -}}
      </p>
      <div class="inventory-swatch-group__items" data-inventory-swatch-group-items>
        {{- out_of_stock_swatches -}}
      </div>
    </div>
    <div
      class="inventory-swatch-group inventory-swatch-group--untracked"
      data-inventory-swatch-group="untracked"
      role="group"
      aria-labelledby="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-untracked"
      {% if untracked_swatches == blank %}
        hidden
      {% endif %}
    >
      <p class="inventory-swatch-group__title" id="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-untracked">
        {{- 'inventory_v2.not_tracked' | t -}}
      </p>
      <div class="inventory-swatch-group__items" data-inventory-swatch-group-items>
        {{- untracked_swatches -}}
      </div>
    </div>
    <div
      class="inventory-swatch-group inventory-swatch-group--missing"
      data-inventory-swatch-group="missing"
      role="group"
      aria-labelledby="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-missing"
      {% if missing_swatches == blank %}
        hidden
      {% endif %}
    >
      <p class="inventory-swatch-group__title" id="InventorySwatchGroup-{{ section.id }}-{{ option.position }}-missing">
        {{- 'inventory_v2.combination_unavailable' | t -}}
      </p>
      <div class="inventory-swatch-group__items" data-inventory-swatch-group-items>
        {{- missing_swatches -}}
      </div>
    </div>
  {%- else -%}
    {{- ungrouped_swatches -}}
  {%- endif -%}
{%- endif -%}
