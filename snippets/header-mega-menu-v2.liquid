{%- liquid
  assign menu_layout = 'navigation'
  assign menu_heading = link.title

  if block != blank
    assign menu_layout = block.settings.layout
    assign menu_heading = block.settings.heading | default: link.title
  endif
-%}

<header-mega-menu-v2
  class="header-mega-menu-v2"
  data-open-delay="150"
  data-close-delay="220"
  {% if block != blank %}{{ block.shopify_attributes }}{% endif %}
>
  <details id="Details-HeaderMenu-{{ index }}" class="mega-menu mega-menu--v2" data-mega-menu-details>
    <summary
      id="HeaderMenu-{{ link.handle }}"
      class="header__menu-item header__menu-item--main list-menu__item link focus-inset"
      aria-expanded="false"
      aria-controls="MegaMenu-Content-{{ index }}"
    >
      <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>{{ link.title | escape }}</span>
      {% render 'icon-caret' %}
    </summary>

    <div
      id="MegaMenu-Content-{{ index }}"
      class="mega-menu__content mega-menu-v2__panel color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
      tabindex="-1"
    >
      <div class="mega-menu-v2__inner mega-menu-v2__inner--{{ menu_layout }}{% if block == blank %} mega-menu-v2__inner--fallback{% endif %} page-width">
        <div class="mega-menu-v2__navigation">
          {%- if block != blank -%}
            <div class="mega-menu-v2__intro">
              <p class="mega-menu-v2__heading">{{ menu_heading | escape }}</p>
              {%- if block.settings.text != blank -%}
                <div class="mega-menu-v2__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
                <a class="mega-menu-v2__cta link" href="{{ block.settings.cta_link }}">
                  {{ block.settings.cta_label | escape }}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

          <ul class="mega-menu-v2__links list-unstyled" role="list">
            {%- for childlink in link.links -%}
              <li class="mega-menu-v2__link-column">
                <a
                  id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                  href="{{ childlink.url }}"
                  class="mega-menu-v2__link mega-menu-v2__link--level-2 link{% if section.settings.highlight_active_link and childlink.current %} mega-menu-v2__link--active{% endif %}"
                  {% if childlink.current %}aria-current="page"{% endif %}
                >
                  {{ childlink.title | escape }}
                </a>

                {%- if childlink.links != blank -%}
                  <ul class="mega-menu-v2__sublinks list-unstyled" role="list">
                    {%- for grandchildlink in childlink.links -%}
                      <li>
                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                          href="{{ grandchildlink.url }}"
                          class="mega-menu-v2__link link{% if section.settings.highlight_active_link and grandchildlink.current %} mega-menu-v2__link--active{% endif %}"
                          {% if grandchildlink.current %}aria-current="page"{% endif %}
                        >
                          {{ grandchildlink.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if link.url != blank and link.url != '#' -%}
            <a class="mega-menu-v2__view-all link" href="{{ link.url }}">
              View all {{ link.title | escape }}
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>

        {%- if block != blank -%}
          {%- case menu_layout -%}
            {%- when 'collection' -%}
              <div class="mega-menu-v2__features mega-menu-v2__features--collections">
                {%- assign collection_setting_ids = 'featured_collection_1,featured_collection_2,featured_collection_3,featured_collection_4' | split: ',' -%}
                {%- for setting_id in collection_setting_ids -%}
                  {%- assign featured_collection = block.settings[setting_id] -%}
                  {%- if featured_collection != blank -%}
                    {% render 'header-mega-menu-card', collection: featured_collection %}
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'editorial' -%}
              <div class="mega-menu-v2__features mega-menu-v2__features--editorial">
                {% render 'header-mega-menu-card',
                  image: block.settings.promo_image_1,
                  heading: block.settings.promo_heading_1,
                  url: block.settings.promo_link_1,
                  collection: block.settings.featured_collection_1,
                  product: block.settings.featured_product_1
                %}
                {% render 'header-mega-menu-card',
                  image: block.settings.promo_image_2,
                  heading: block.settings.promo_heading_2,
                  url: block.settings.promo_link_2,
                  collection: block.settings.featured_collection_2,
                  product: block.settings.featured_product_2
                %}
              </div>

            {%- when 'navigation' -%}
              {%- if block.settings.promo_image_1 != blank or block.settings.featured_collection_1 != blank or block.settings.featured_product_1 != blank -%}
                <div class="mega-menu-v2__features mega-menu-v2__features--single">
                  {% render 'header-mega-menu-card',
                    image: block.settings.promo_image_1,
                    heading: block.settings.promo_heading_1,
                    url: block.settings.promo_link_1,
                    collection: block.settings.featured_collection_1,
                    product: block.settings.featured_product_1
                  %}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endif -%}
      </div>
    </div>
  </details>
</header-mega-menu-v2>
