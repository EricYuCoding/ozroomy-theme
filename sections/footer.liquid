  .footer-block--email-signup-advanced .email-signup-advanced__button:hover {
    background-color: var(--email-signup-advanced-button-hover-background);
    color: var(--email-signup-advanced-button-hover-text);
  }

  .footer-block--email-signup-advanced .email-signup-advanced__button:focus,
  .footer-block--email-signup-advanced .email-signup-advanced__button:focus-visible {
    outline: 0.2rem solid var(--email-signup-advanced-supporting-color);
    outline-offset: 0.3rem;
    box-shadow: none;
  }

  .email-signup-advanced--button-content .email-signup-advanced__button {
    width: auto;
    max-width: 100%;
  }

  .email-signup-advanced--button-custom .email-signup-advanced__button {
    width: var(--email-signup-advanced-button-width);
    max-width: 100%;
  }

  .email-signup-advanced__message {
    align-items: flex-start;
    justify-content: flex-start;
    margin: 0;
    color: var(--email-signup-advanced-supporting-color);
    font-size: 1.3rem;
    text-align: left;
  }

  .email-signup-advanced__message .icon {
    flex: 0 0 auto;
    margin-top: 0.2rem;
  }

  .email-signup-advanced__microcopy {
