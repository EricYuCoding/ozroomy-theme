{% comment %}
  countdown-timer.liquid
{% endcomment %}

{% schema %}
{
  "name": "Countdown Timer",
  "settings": [
    {
      "type": "text",
      "id": "countdown_message",
      "label": "Countdown Message",
      "default": "Hurry up! Sale ends in:"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown End Date (YYYY-MM-DD)",
      "default": "2024-10-21"
    },
    {
      "type": "number",
      "id": "reset_interval",
      "label": "Reset Interval (Days)",
      "default": 2
    },
    {
      "type": "select",
      "id": "timer_alignment",
      "label": "Timer Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "message_font_size",
      "label": "Message Font Size (px)",
      "min": 12,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "timer_font_size",
      "label": "Timer Font Size (px)",
      "min": 12,
      "max": 72,
      "step": 1,
      "default": 36
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div id="countdown-timer">
  <p id="countdown-message">{{ section.settings.countdown_message }}</p>
  <div id="countdown">
    <div class="time-section">
      <span class="time" id="days-{{ section.id }}">00</span>
      <span class="label">Days</span>
    </div>
    <div class="time-section">
      <span class="time" id="hours-{{ section.id }}">00</span>
      <span class="label">Hours</span>
    </div>
    <div class="time-section">
      <span class="time" id="minutes-{{ section.id }}">00</span>
      <span class="label">Minutes</span>
    </div>
    <div class="time-section">
      <span class="time" id="seconds-{{ section.id }}">00</span>
      <span class="label">Seconds</span>
    </div>
  </div>
  <style>
    /* Inline CSS */
    #countdown-timer {
      text-align: {{ section.settings.timer_alignment }};
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    #countdown-message {
      font-size: {{ section.settings.message_font_size }}px;
      margin-bottom: 10px;
    }

    #countdown {
      display: flex;
      justify-content: center; /* Center the time sections */
      flex-wrap: nowrap;
      max-width: 100%;
      white-space: nowrap;
    }

    .time-section {
      text-align: center;
      margin: 0 50px; /* Reduced margin for closer spacing */
      flex-shrink: 0; /* Prevent shrinking */
    }

    .time {
      font-size: {{ section.settings.timer_font_size }}px;
      font-weight: bold;
      display: block;
      width: 40px; /* Fixed width to prevent shifting */
      font-family: 'Courier New', Courier, monospace; /* Monospaced font */
      margin: 0 auto;
    }

    .label {
      font-size: 14px;
      display: block;
    }

    /* Adjustments for mobile devices */
    @media (max-width: 767px) {
      .time {
        font-size: {{ section.settings.timer_font_size | divided_by: 1.2 }}px;
        width: 30px; /* Adjusted width for mobile */
      }

      .label {
        font-size: 10px;
      }

      .time-section {
        margin: 0 20px; /* Smaller margins on mobile */
      }
    }
  </style>
  <script>
    // Inline JavaScript
    document.addEventListener('DOMContentLoaded', function() {
      // Get settings from Liquid variables
      var initialDateStr = "{{ section.settings.countdown_date }}";
      var resetInterval = {{ section.settings.reset_interval }};
    
      // Parse the initial date string into components
      var dateParts = initialDateStr.split('-');
    
      if (dateParts.length !== 3) {
        console.error('Invalid date format. Please use YYYY-MM-DD.');
        document.getElementById('countdown').innerHTML = 'Invalid date format.';
        return;
      }
    
      var year = parseInt(dateParts[0], 10);
      var month = parseInt(dateParts[1], 10) - 1; // Months are zero-based in JS
      var day = parseInt(dateParts[2], 10);
    
      var initialDate = new Date(year, month, day, 23, 59, 59); // Set end time to 23:59:59
    
      // Validate the initial date
      if (isNaN(initialDate.getTime())) {
        console.error('Invalid date components. Please check the date.');
        document.getElementById('countdown').innerHTML = 'Invalid date.';
        return;
      }
    
      function calculateNextCountdownDate() {
        var now = new Date();
        var nextCountdownDate = new Date(initialDate);
    
        // Continuously add resetInterval days until nextCountdownDate is in the future
        while (nextCountdownDate <= now) {
          nextCountdownDate.setDate(nextCountdownDate.getDate() + resetInterval);
        }
    
        return nextCountdownDate;
      }
    
      function updateCountdown() {
        var countdownDate = calculateNextCountdownDate();
    
        var now = new Date().getTime();
        var distance = countdownDate - now;
    
        // Time calculations
        var days = Math.floor(distance / (1000 * 60 * 60 * 24));
        var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((distance % (1000 * 60)) / 1000);
    
        // Handle negative values (timer expired)
        if (distance < 0) {
          days = hours = minutes = seconds = 0;
        }
    
        // Display the result with leading zeros
        document.getElementById('days-{{ section.id }}').innerHTML = days < 10 ? '0' + days : days;
        document.getElementById('hours-{{ section.id }}').innerHTML = hours < 10 ? '0' + hours : hours;
        document.getElementById('minutes-{{ section.id }}').innerHTML = minutes < 10 ? '0' + minutes : minutes;
        document.getElementById('seconds-{{ section.id }}').innerHTML = seconds < 10 ? '0' + seconds : seconds;
      }
    
      // Initial call to display countdown immediately
      updateCountdown();
    
      // Update the countdown every 1 second
      setInterval(updateCountdown, 1000);
    });
  </script>
</div>
