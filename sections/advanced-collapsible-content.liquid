{{ 'component-advanced-collapsible.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .advanced-collapsible-content-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .advanced-collapsible-content-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="advanced-collapsible-content color-{{ section.settings.color_scheme }} gradient">
  <div class="advanced-collapsible-content-{{ section.id }} page-width">
    <div class="advanced-collapsible-content__inner">
      {%- if section.settings.title != blank -%}
        <h2 class="advanced-collapsible-content__heading advanced-collapsible-content__heading--{{ section.settings.heading_alignment }} {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      <div class="advanced-collapsible-content__rows">
        {%- for block in section.blocks -%}
          {% render 'advanced-collapsible-row', block: block, section: section, context: 'standalone' %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Advanced collapsible",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Advanced collapsible content",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "advanced_collapsible_row",
      "name": "Advanced collapsible row",
      "settings": [
        {
          "type": "header",
          "content": "Heading"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Advanced collapsible row",
          "label": "Heading"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color"
        },
        {
          "type": "range",
          "id": "heading_size",
          "min": 12,
          "max": 32,
          "step": 1,
          "unit": "px",
          "label": "Heading size",
          "default": 16
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Heading weight",
          "options": [
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semi-bold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
          "default": "600"
        },
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Material icon",
          "info": "Optional. Enter a Material Symbols icon name."
        },
        {
          "type": "checkbox",
          "id": "filled_icon",
          "default": false,
          "label": "Filled icon"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon"
        },
        {
          "type": "header",
          "content": "Disclosure"
        },
        {
          "type": "checkbox",
          "id": "open",
          "default": false,
          "label": "Open row by default"
        },
        {
          "type": "select",
          "id": "collapse_icon",
          "label": "Collapse icon",
          "options": [
            {
              "value": "caret",
              "label": "Caret"
            },
            {
              "value": "plus",
              "label": "Plus"
            }
          ],
          "default": "caret"
        },
        {
          "type": "checkbox",
          "id": "display_top_border",
          "default": true,
          "label": "Display top border"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Row content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "above",
              "label": "Above content"
            },
            {
              "value": "below",
              "label": "Below content"
            }
          ],
          "default": "above"
        },
        {
          "type": "select",
          "id": "image_alignment",
          "label": "Image alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 20,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Image width",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advanced collapsible",
      "blocks": [
        {
          "type": "advanced_collapsible_row"
        },
        {
          "type": "advanced_collapsible_row"
        },
        {
          "type": "advanced_collapsible_row"
        }
      ]
    }
  ]
}
{% endschema %}
