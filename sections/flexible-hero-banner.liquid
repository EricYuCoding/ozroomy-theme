        { "value": "play", "label": "Play video" }
      ],
      "default": "poster"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Video position",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
