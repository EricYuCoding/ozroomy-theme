        { "value": "bottom", "label": "Bottom gradient" },
        { "value": "left", "label": "Left gradient" }
      ],
      "default": "even"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Desktop overlay opacity",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Mobile overlay opacity",
      "default": 35
    },
    {
      "type": "paragraph",
      "content": "Check that text and buttons maintain adequate contrast over every image and video frame."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "custom", "label": "Custom text" }
      ],
