        "custom_liquid_HHyGXn": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"oz-preorder-benefits\">\n  <details class=\"oz-preorder-accordion\" open>\n    <summary class=\"oz-preorder-summary\">\n      <span class=\"oz-preorder-title\">Pre-order Benefits</span>\n      <span class=\"oz-preorder-toggle\" aria-hidden=\"true\"></span>\n    </summary>\n\n    <div class=\"oz-preorder-content\">\n      <div class=\"oz-preorder-card\">\n        <div class=\"oz-preorder-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"9\" cy=\"20\" r=\"1.5\"></circle>\n            <circle cx=\"18\" cy=\"20\" r=\"1.5\"></circle>\n            <path d=\"M3 4h2l2.2 9.2a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20 8H7.2\"></path>\n            <path d=\"M7 8h13\"></path>\n          </svg>\n        </div>\n        <div class=\"oz-preorder-text\">\n          <h4>First In, Best Dressed</h4>\n          <p>\n            Our newest sofa bed, made in limited batches. The Nest features premium pocket springs for real comfort, from sofa to sleep.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"oz-preorder-card\">\n        <div class=\"oz-preorder-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 3l2.4 2.1 3.1-.2.8 3 2.7 1.6-1.3 2.8 1.3 2.8-2.7 1.6-.8 3-3.1-.2L12 21l-2.4-2.1-3.1.2-.8-3-2.7-1.6 1.3-2.8-1.3-2.8L6.5 7.9l.8-3 3.1.2L12 3z\"></path>\n            <path d=\"M9 12h6\"></path>\n            <path d=\"M12 9v6\"></path>\n          </svg>\n        </div>\n        <div class=\"oz-preorder-text\">\n          <h4>Shop Now and Save</h4>\n          <p>\n            Pre-order pricing is available for a limited time. Once in stock, the product returns to full price.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"oz-preorder-card\">\n        <div class=\"oz-preorder-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"1.5\" y=\"7\" width=\"15\" height=\"10\" rx=\"1.5\"></rect>\n            <path d=\"M16.5 10h3l2 2.5V17h-5\"></path>\n            <circle cx=\"6\" cy=\"18.5\" r=\"1.5\"></circle>\n            <circle cx=\"18\" cy=\"18.5\" r=\"1.5\"></circle>\n            <path d=\"M6 11h5\"></path>\n          </svg>\n        </div>\n        <div class=\"oz-preorder-text\">\n          <h4>Prioritised Delivery</h4>\n          <p>\n            Pre-orders are queued first, so your order is prepared for dispatch as soon as the incoming batch reaches our warehouse.\n          </p>\n        </div>\n      </div>\n    </div>\n  </details>\n</div>\n\n<style>\n  .oz-preorder-benefits {\n    margin: 18px 0;\n    border-bottom: 1px solid rgba(0,0,0,0.15);\n    padding-bottom: 14px;\n  }\n\n  .oz-preorder-accordion {\n    display: block;\n  }\n\n  .oz-preorder-accordion summary {\n    list-style: none;\n  }\n\n  .oz-preorder-accordion summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .oz-preorder-summary {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    cursor: pointer;\n    padding: 4px 0 14px;\n  }\n\n  .oz-preorder-title {\n    font-size: 22px;\n    line-height: 1.1;\n    font-weight: 600;\n    letter-spacing: -0.02em;\n    color: #1f2a24;\n  }\n\n  .oz-preorder-toggle {\n    position: relative;\n    width: 24px;\n    height: 24px;\n    flex: 0 0 24px;\n  }\n\n  .oz-preorder-toggle::before,\n  .oz-preorder-toggle::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 20px;\n    height: 2px;\n    background: #1f2a24;\n    border-radius: 2px;\n    transform: translate(-50%, -50%);\n    transition: transform 0.2s ease, opacity 0.2s ease;\n  }\n\n  .oz-preorder-toggle::after {\n    transform: translate(-50%, -50%) rotate(90deg);\n  }\n\n  .oz-preorder-accordion[open] .oz-preorder-toggle::after {\n    opacity: 0;\n    transform: translate(-50%, -50%) rotate(90deg) scaleX(0);\n  }\n\n  .oz-preorder-content {\n    display: grid;\n    gap: 16px;\n    padding-bottom: 12px;\n  }\n\n  .oz-preorder-card {\n    display: grid;\n    grid-template-columns: 64px 1fr;\n    gap: 18px;\n    align-items: center;\n    background: #f2f3ee;\n    border-radius: 10px;\n    padding: 22px 22px 22px 18px;\n  }\n\n  .oz-preorder-icon {\n    width: 44px;\n    height: 44px;\n    color: #1f2a24;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .oz-preorder-icon svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .oz-preorder-text h4 {\n    margin: 0 0 6px;\n    font-size: 12px;\n    line-height: 1.2;\n    font-weight: 600;\n    color: #1f2a24;\n  }\n\n  .oz-preorder-text p {\n    margin: 0;\n    font-size: 10px;\n    line-height: 1.4;\n    color: #1f2a24;\n    opacity: 0.9;\n    font-weight: 500;\n  }\n\n  @media screen and (max-width: 749px) {\n    .oz-preorder-title {\n      font-size: 20px;\n    }\n\n    .oz-preorder-card {\n      grid-template-columns: 48px 1fr;\n      gap: 14px;\n      padding: 16px;\n    }\n\n    .oz-preorder-icon {\n      width: 34px;\n      height: 34px;\n    }\n\n    .oz-preorder-text h4 {\n      font-size: 14px;\n    }\n\n    .oz-preorder-text p {\n      font-size: 10px;\n    }\n  }\n</style>"
