    "custom_liquid_GH3JgR": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n  /* 外部容器：控制白色背景和上下间距 */\n  .custom-video-section {\n    background-color: #ffffff;\n    padding: 60px 20px;\n    text-align: center;\n    font-family: inherit; /* 自动继承你Shopify主题的字体 */\n  }\n\n  /* 主标题样式 */\n  .custom-video-heading {\n    font-size: 36px;\n    font-weight: 400;\n    color: #333333;\n    margin-bottom: 15px;\n    line-height: 1.2;\n  }\n\n  /* 副标题/链接样式 */\n  .custom-video-subheading {\n    font-size: 14px;\n    font-weight: 600;\n    color: #000000;\n    margin-bottom: 40px;\n    text-decoration: none;\n    display: inline-block;\n    cursor: pointer;\n  }\n\n  .custom-video-subheading:hover {\n    text-decoration: underline;\n  }\n\n  /* 视频外层容器：控制最大宽度、居中和圆角 */\n  .custom-video-wrapper {\n    max-width: 900px; /* 控制视频最大宽度，数值可根据你的UI偏好微调 */\n    margin: 0 auto;\n    width: 100%;\n    border-radius: 12px; /* 视频圆角效果 */\n    overflow: hidden; /* 确保视频内容不超出圆角 */\n    aspect-ratio: 16 / 9; /* 保持16:9的视频比例，高度会自动计算 */\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); /* 可选：加一点极淡的阴影提升质感 */\n  }\n\n  /* 视频播放器设置 */\n  .custom-video-wrapper video,\n  .custom-video-wrapper iframe {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    border: none;\n    display: block;\n  }\n\n  /* 移动端专属优化 (屏幕宽度小于 768px 时触发) */\n  @media screen and (max-width: 768px) {\n    .custom-video-section {\n      padding: 40px 15px; /* 减小移动端的上下边距 */\n    }\n    .custom-video-heading {\n      font-size: 26px; /* 缩小主标题字体 */\n    }\n    .custom-video-subheading {\n      margin-bottom: 25px; /* 减小视频上方的间距 */\n    }\n    .custom-video-wrapper {\n      border-radius: 8px; /* 移动端稍微减小圆角弧度 */\n    }\n  }\n</style>\n\n<div class=\"custom-video-section\">\n  <h2 class=\"custom-video-heading\">Lightweight, Flexible, and Customisable</h2>\n  <a href=\"#your-link-here\" class=\"custom-video-subheading\">Watch here to see how.</a>\n  \n  <div class=\"custom-video-wrapper\">\n    <video autoplay loop muted playsinline>\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/56e82d9115684f368d38329ea2d416aa.mp4\" type=\"video/mp4\">\n      Your browser does not support the video tag.\n    </video>\n    \n    </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
