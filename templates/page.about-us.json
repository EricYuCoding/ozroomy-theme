        "text_KB9jmJ": {
          "type": "text",
          "settings": {
            "text": "<p>Our story started in Australia, living in an apartment like many others.</p><p>Traditional sofas were heavy, bulky, and costly to deliver.<br/><br/>We had to book elevators with the building manager, worry about narrow hallways, and spend hours setting everything up once it arrived.</p><p>The whole process felt stressful and unnecessary.<br/><br/>So we asked a simple question:</p><p><strong>Why does buying a sofa have to be this hard?</strong></p>"
          }
        }
