        "text_VArVLy": {
          "type": "text",
          "settings": {
            "text": "<p>We redesigned the sofa experience from the inside out.</p><ul><li><strong>Compressed, roll-packed foam</strong><br/><br/>All our soft foam components are compressed and roll-packed to reduce volume, lower shipping costs, and make delivery easier.<br/></li><li><strong>Sofa in a box</strong><br/><br/>Smaller cartons mean fewer delivery issues and no more worrying about doors, lifts, or tight corners.<br/></li><li><strong>Modular by design</strong><br/><br/>Our sofas are made in modules, so setup feels intuitive, flexible, and stress-free.<br/></li><li><strong>Customisation that actually helps</strong><br/><br/>We offer customisation because homes are different. Layouts are different. People are different.<br/></li></ul><p>The goal is simple:<br/>a sofa that fits your space, your life, and arrives without the headache.</p>",
            "text_style": "body"
          }
        }
