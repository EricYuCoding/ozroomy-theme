    "custom_liquid_9zVJfU": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"custom-features-wrapper\">\n  <div class=\"feature-item\">\n    <div class=\"feature-icon\">\n      <span class=\"badge\">1</span>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M4 18v3h16v-3M4 11l-1 5v2h18v-2l-1-5M6 11V5a2 2 0 012-2h8a2 2 0 012 2v6M4 11h16\" /></svg>\n    </div>\n    <div class=\"feature-content-rich\">\n      {{ product.metafields.custom.feature1 | metafield_tag }}\n    </div>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <div class=\"feature-item\">\n    <div class=\"feature-icon\">\n      <span class=\"badge\">2</span>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M5 18h14M17 18l1-4h3v-4h-5.5L13 6H4v8h2M8 18h2\" /></svg>\n    </div>\n    <div class=\"feature-content-rich\">\n      {{ product.metafields.custom.feature2 | metafield_tag }}\n    </div>\n  </div>\n\n  <div class=\"divider\"></div>\n\n  <div class=\"feature-item\">\n    <div class=\"feature-icon\">\n      <span class=\"badge\">3</span>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" /></svg>\n    </div>\n    <div class=\"feature-content-rich\">\n      {{ product.metafields.custom.feature3 | metafield_tag }}\n    </div>\n  </div>\n</div>\n\n<style>\n  /* PC端全局样式 */\n  .custom-features-wrapper {\n    display: flex;\n    justify-content: space-around;\n    align-items: flex-start;\n    padding: 40px 20px;\n    background-color: #f1f3f0;\n    text-align: center;\n  }\n  .feature-item {\n    flex: 1;\n    padding: 0 20px;\n    max-width: 350px;\n    display: flex;\n    flex-direction: column; /* PC端保持上下排列 */\n    align-items: center;\n  }\n  .feature-icon {\n    position: relative;\n    display: inline-block;\n    margin-bottom: 15px;\n    flex-shrink: 0; /* 防止图标被压缩 */\n  }\n  .feature-icon svg {\n    width: 50px;\n    height: 50px;\n    color: #2c3e50;\n  }\n  .badge {\n    position: absolute;\n    top: -8px;\n    right: -8px;\n    background: #2c3e50;\n    color: white;\n    border-radius: 50%;\n    width: 20px;\n    height: 20px;\n    font-size: 11px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .feature-content-rich h3 {\n    font-size: 1.2rem;\n    font-weight: bold;\n    color: #1a302e;\n    margin: 0 0 8px 0;\n  }\n  .feature-content-rich p {\n    font-size: 0.95rem;\n    line-height: 1.4;\n    color: #4a4a4a;\n    margin: 0;\n  }\n  .divider {\n    width: 1px;\n    height: 80px;\n    background-color: #ccc;\n    align-self: center;\n  }\n\n  /* 移动端适配 (重点修改部分) */\n  @media (max-width: 768px) {\n.badge {\n    top: 10px !important;   /* 向上移动，!important 确保覆盖 PC 端样式 */\n    right: -12px !important; /* 向右移动 */\n    width: 18px !important;  /* 移动端如果觉得数字太大可以稍微缩小 */\n    height: 18px !important;\n    font-size: 10px !important;\n  }\n    .custom-features-wrapper {\n      flex-direction: column;\n      align-items: center;\n      padding: 30px 15px;\n    }\n    .feature-item {\n      flex-direction: row; /* 图标文字水平排列 */\n      align-items: flex-start; /* 顶部对齐 */\n      text-align: left; /* 文字左对齐 */\n      padding: 0;\n      margin-bottom: -10px;\n      max-width: 100%;\n      width: 100%;\n    }\n    .feature-icon {\n      margin-bottom: 1;\n      margin-right: 20px; /* 图标与文字的间距 */\n    }\n    .feature-icon svg {\n      width: 45px; /* 移动端图标稍微缩小 */\n      height: 45px;\n      margin-top: 15px;\n    }\n    .feature-content-rich h3 {\n      font-size: 1.1rem;\n      margin-bottom: 5px;\n    }\n    .feature-content-rich p {\n      font-size: 0.9rem;\n    }\n    .divider {\n      display: none; /* 隐藏分割线 */\n    }\n    .feature-item:last-child {\n      margin-bottom: 0;\n    }\n  }\n</style>",
