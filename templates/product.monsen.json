            "atc_skip_cart": false
          }
        },
        "row_h69KPq": {
          "type": "row",
          "settings": {
            "caption": "",
            "title": "Built for a Lifetime of Lounging",
            "title_highlight_color": "#121212",
            "text": "<p>Most cushions flatten in months, but ours are engineered for the long haul. Tested to simulate 10 years of heavy daily use, our high-resilience cores defy sagging—ensuring your sofa stays as supportive and beautiful as the day it arrived.</p>",
            "button_label": "",
