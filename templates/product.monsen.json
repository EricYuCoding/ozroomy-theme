          "type": "row",
          "settings": {
            "caption": "",
            "title": "Modular by Nature",
            "title_highlight_color": "#6d388b",
            "text": "<p><br/>Rearrange it. Expand it. Refresh it with new covers. Rest adapts as your home evolves.<br/><br/></p>",
