            "atc_button_label": "",
            "atc_product": "",
            "atc_skip_cart": false
          }
        },
        "row_LjJKCq": {
          "type": "row",
          "settings": {
            "caption": "",
            "title": "Tool-Free. Stress-Free.",
            "title_highlight_color": "#6d388b",
            "text": "<p>No screws. No hex keys. Just unpack, slide together, and you’re done. Rest is built to assemble in minutes — not hours.</p>",
