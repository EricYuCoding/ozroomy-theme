        "row_TYAT8K": {
          "type": "row",
          "settings": {
            "caption": "",
            "title": "<strong>Claw-Resistant Fabric</strong>",
            "title_highlight_color": "#121212",
            "text": "<p><br/>Built for homes with furry friends. Our high-density weave significantly enhances resistance to scratches and snags, standing up to daily stretches and playful paws without sacrificing style.<br/><br/></p>",
            "button_label": "",
            "button_link": "",
            "atc_button_label": "",
            "atc_product": "",
            "atc_skip_cart": false
          }
        },
        "row_ARgrxw": {
          "type": "row",
          "settings": {
            "caption": "",
            "title": "Kid, Pet & Party-Proof",
            "title_highlight_color": "#6d388b",
            "text": "<p>From muddy paws to red wine spills, our <strong>water-repellent shield</strong> has you covered. Liquids simply bead up for a quick wipe-clean, making everyday \"oopsies\" a thing of the past.</p>",
            "button_label": "",
            "button_link": "",
