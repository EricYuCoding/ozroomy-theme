          "type": "row",
          "settings": {
            "image": "shopify://shop_images/box-pebble-ozdesign-no-gemini.webp",
            "caption": "",
            "title": "Fits Any Doorway",
            "title_highlight_color": "#6d388b",
            "text": "<p>Flat-packed for easy delivery. Designed to move through narrow hallways, staircases and tight spaces without the struggle.</p>",
            "button_label": "",
